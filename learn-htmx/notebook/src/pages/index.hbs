<div class="flex-col space-y-2">
  <header>
    <h1 class="text-3xl font-bold">notebook</h1>
    <p>
      htmx 4 playground
    </p>
  </header>

  <section>
    <h2 class="font-bold">GET: swap a fragment</h2>
    <button
      class="border px-2"
      hx-get="/components/hello"
      hx-target="#hello"
    >
      Say hello
    </button>
    <div id="hello">nothing yet</div>
  </section>

  <section>
    <h2 class="font-bold">POST a form: 422 validation</h2>
    <form hx-post="/components/greet" hx-target="#greet">
      <input
        class="border px-2"
        type="text"
        name="name"
        placeholder="your name"
      />
      <button class="border px-2" type="submit">Greet</button>
    </form>
    <div id="greet">
      submit an empty name to see the 422 path
    </div>
  </section>
</div>
